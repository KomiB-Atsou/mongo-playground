#!/bin/env python3

import os

from dotenv import load_dotenv
from pymongo import MongoClient
from bson import Decimal128

# Load environment variables from .env file
load_dotenv(dotenv_path="/lab/.env")

# Get MongoDB URI from environment variable
uri = os.environ.get("MONGODB_URI")

# Create a MongoDB client and connect to the database
client = MongoClient(uri)


# Step 1: Define the callback that specifies the sequence of operations to perform inside the transaction.
def callback(
    session,
    transfer_id=None,
    account_id_receiver=None,
    account_id_sender=None,
    transfer_amount=None,
):
    """Callback for multi-document transaction.

    Executes the sequence of operations for a money transfer between two accounts,
    including updating both account balances and recording the transfer.

    Args:
        session: The MongoDB session object for the transaction.
        transfer_id: The unique identifier for the transfer.
        account_id_receiver: The account ID of the receiver.
        account_id_sender: The account ID of the sender.
        transfer_amount: The amount to transfer.
    """
    # Get reference to 'accounts' collection
    accounts_collection = session.client.bank.accounts

    # Get reference to 'transfers' collection
    transfers_collection = session.client.bank.transfers

    transfer = {
        "transfer_id": transfer_id,
        "to_account": account_id_receiver,
        "from_account": account_id_sender,
        "amount": Decimal128(str(transfer_amount)),
    }

    # Transaction operations
    # Important: You must pass the session to each operation

    # Update sender account: subtract transfer amount from balance and add transfer ID
    accounts_collection.update_one(
        {"account_id": account_id_sender},
        {
            "$inc": {"balance": -transfer_amount},
            "$push": {"transfers_complete": transfer_id},
        },
        session=session,
    )

    # Update receiver account: add transfer amount to balance and add transfer ID
    accounts_collection.update_one(
        {"account_id": account_id_receiver},
        {
            "$inc": {"balance": transfer_amount},
            "$push": {"transfers_complete": transfer_id},
        },
        session=session,
    )

    # Add new transfer to 'transfers' collection
    transfers_collection.insert_one(transfer, session=session)

    print("Transaction successful")


def callback_wrapper(s):
    """
    Wrapper function that executes a callback with predefined transfer parameters.

    Args:
        s: The session object to pass to the callback function.

    Returns:
        The return value of the callback function.
    """
    callback(
        s,
        transfer_id="TR218721873",
        account_id_receiver="MDB343652528",
        account_id_sender="MDB574189300",
        transfer_amount=100,
    )


# Start a client session, then carry out a transaction.
with client.start_session() as session:
    session.with_transaction(callback_wrapper)

# Close the MongoDB connection
client.close()
